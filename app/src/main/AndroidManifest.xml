<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DuBaoThoiTiet"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 1. Login Activity - LAUNCHER -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Main Activity - Today Weather -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- 3. Register Activity -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".LoginActivity"/>

        <!-- 4. User Profile Activity -->
        <activity
            android:name=".UserProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 5. Hourly Forecast Activity -->
        <activity
            android:name=".HourlyForecastActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 6. Forecast 3 Days Activity -->
        <activity
            android:name=".Forecast3DaysActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 7. Forecast 7 Days Activity -->
        <activity
            android:name=".ForecastActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 8. Current Location Weather Activity -->
        <activity
            android:name=".CurrentLocationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 9. Search Location Activity -->
        <activity
            android:name=".SearchLocationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 10. Weather Compare Activity -->
        <activity
            android:name=".WeatherCompareActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 11. Weather Details Activity -->
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 12. Air Quality Activity -->
        <activity
            android:name=".AirQualityActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 13. Weather Alerts Activity -->
        <activity
            android:name=".WeatherAlertsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 14. Lifestyle Advice Activity -->
        <activity
            android:name=".LifestyleAdviceActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 15. Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

        <!-- 16. User Management Admin Activity -->
        <activity
            android:name=".UserManagementActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".MainActivity"/>

    </application>

</manifest>