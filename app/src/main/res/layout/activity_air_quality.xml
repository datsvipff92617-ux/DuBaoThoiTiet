<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackAqi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/button_circle"
                android:contentDescription="Quay lại"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍃 Chất Lượng Không Khí"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>

        <!-- City Subtitle -->
        <TextView
            android:id="@+id/tvAqiCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khu vực: Hà Nội"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Main AQI Score Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_background"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chỉ Số Ô Nhiễm (US EPA)"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvAqiIndexNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#FFEB3B"
                android:textSize="64sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAqiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trung Bình (Moderate)"
                android:textColor="#FFEB3B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvAqiSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chất lượng không khí ở mức chấp nhận được đối với hầu hết mọi người."
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Detailed Pollutants Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nồng Độ Các Chất Gây Ô Nhiễm"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Row 1: PM2.5 & PM10 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bụi mịn PM2.5"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvPm25"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28.4 µg/m³"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bụi thô PM10"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvPm10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45.1 µg/m³"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: CO & NO2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khí CO"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvCo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="340.5 µg/m³"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khí NO2"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvNo2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18.2 µg/m³"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3: O3 & SO2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khí Ozone (O3)"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvO3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="55.0 µg/m³"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khí SO2"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvSo2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.8 µg/m³"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Health Recommendations Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩺 Khuyến Cáo Bảo Vệ Sức Khỏe"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvAqiMaskAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="😷 Đeo khẩu trang: Nên đeo khẩu trang khi tham gia giao thông giờ cao điểm."
                android:textColor="#E0F7FA"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvAqiWindowAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🪟 Mở cửa sổ thông thoáng: Có thể mở cửa vào buổi sáng sớm."
                android:textColor="#E0F7FA"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvAqiOutdoorAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏃 Vận động ngoài trời: Người bình thường có thể tập thể dục, nhóm nhạy cảm nên giảm cường độ."
                android:textColor="#E0F7FA"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
