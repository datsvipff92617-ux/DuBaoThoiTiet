<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackCurrentLoc"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/button_circle"
                android:contentDescription="Quay lại"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Vị Trí Của Bạn"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>

        <!-- GPS Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/search_background"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvGpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Đang kết nối định vị vệ tinh GPS..."
                android:textColor="@android:color/white"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Card Main Weather -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvCurrentLocCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang xác định vị trí..."
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvCurrentLocCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tọa độ: Đang tính toán..."
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvCurrentLocTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°C"
                android:textColor="@android:color/white"
                android:textSize="54sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvCurrentLocCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trạng thái thời tiết"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvCurrentLocFeelsLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cảm giác như: --°C"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Grid Chi tiết khí tượng tại vị trí -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông Số Môi Trường Xung Quanh"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvCurrentLocHumidity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💧 Độ ẩm: --%"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvCurrentLocWind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💨 Gió: -- km/h"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvCurrentLocUV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="☀️ Chỉ số UV: --"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvCurrentLocPressure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⏱️ Áp suất: -- mb"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:id="@+id/tvCurrentLocVisibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👁️ Tầm nhìn: -- km"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvCurrentLocCloud"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="☁️ Độ che phủ: --%"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Nút thao tác -->
        <Button
            android:id="@+id/btnRefreshLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Cập Nhật Vị Trí &amp; Thời Tiết Ngay"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:background="@drawable/button_normal"
            android:padding="14dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
