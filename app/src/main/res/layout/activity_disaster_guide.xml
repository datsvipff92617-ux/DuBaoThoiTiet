<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackDisaster"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/button_circle"
                android:contentDescription="Quay lại"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvDisasterHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚨 Cẩm Nang Sinh Tồn Thiên Tai"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>

        <!-- Thẻ Đường Dây Nóng Khẩn Cấp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvEmergencyHotlineLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 ĐƯỜNG DÂY NÓNG CỨU HỘ KHẨN CẤP (Bấm để gọi):"
                android:textColor="#FF8A80"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnCall112"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🆘 112\nCứu Nạn"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:background="@drawable/button_normal"
                    android:layout_marginEnd="4dp"
                    android:padding="6dp"/>

                <Button
                    android:id="@+id/btnCall114"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚒 114\nCứu Hỏa"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:background="@drawable/button_normal"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:padding="6dp"/>

                <Button
                    android:id="@+id/btnCall115"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚑 115\nCấp Cứu"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:background="@drawable/button_normal"
                    android:layout_marginStart="4dp"
                    android:padding="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Kỹ năng 1: Dông sét -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvDisasterSec1Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 1. PHÒNG TRÁNH DÔNG LỐC &amp; SẤM SÉT NGUY HIỂM"
                android:textColor="#FFD54F"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDisasterSec1Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Quy tắc 30-30: Thấy chớp và nghe sấm cách nhau dưới 30 giây thì phải tìm nơi trú ẩn ngay.\n• Tuyệt đối KHÔNG trú mưa dưới gốc cây to, cột điện, biển quảng cáo kim loại.\n• Đang ở ngoài đồng hoặc sân rộng: Ngồi xổm, chụm 2 chân, không nằm rạp xuống đất.\n• Trong nhà: Rút phích cắm TV, máy tính, tránh dùng điện thoại cắm sạc."
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- Kỹ năng 2: Bão lớn & Lốc xoáy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvDisasterSec2Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌀 2. ỨNG PHÓ BÃO MẠNH &amp; ÁP THẤP NHIỆT ĐỚI"
                android:textColor="#80D8FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDisasterSec2Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Chằng chống mái nhà, dán băng keo chữ X lên cửa kính chống vỡ.\n• Chuẩn bị sẵn túi đồ sinh tồn: Đèn pin, pin dự phòng, nước uống, đồ ăn khô 3 ngày.\n• Chặt tỉa cành cây xung quanh nhà có nguy cơ gãy đổ.\n• Luôn theo dõi bản tin dự báo trên app để nắm hướng đi và cấp độ của bão."
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- Kỹ năng 3: Ngập lụt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvDisasterSec3Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌊 3. AN TOÀN TRONG MÙA MƯA NGẬP LỤT ĐÔ THỊ"
                android:textColor="#A7FFEB"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDisasterSec3Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Cảnh giác nắp cống hố ga bị mất nắp do áp lực nước trồi lên.\n• Ngắt cầu dao điện tổng trong nhà nếu nước dâng cao qua ổ cắm tầng 1.\n• Không cố lái xe máy/ô tô qua đoạn đường ngập sâu quá nửa bánh xe (nguy cơ thủy kích hỏng máy).\n• Tránh xa các cột điện chiếu sáng đường phố (nguy cơ rò rỉ điện ngầm dưới nước)."
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- Kỹ năng 4: Nắng nóng cực đoan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvDisasterSec4Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ 4. PHÒNG TRÁNH NẮNG NÓNG GAY GẮT &amp; SAY NẮNG"
                android:textColor="#FFAB91"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDisasterSec4Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Hạn chế làm việc nặng hoặc ra ngoài trong khung giờ 11h00 - 15h00.\n• Uống đủ 2 - 2.5 lít nước mỗi ngày, bổ sung khoáng chất Oresol khi đổ nhiều mồ hôi.\n• Dấu hiệu say nắng / sốc nhiệt: Chóng mặt, buồn nôn, da nóng đỏ nhưng không ra mồ hôi -> Cần đưa ngay vào bóng râm và chườm mát vùng cổ, nách."
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
