<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack3Days"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/button_circle"
                android:contentDescription="Quay lại"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvTitle3Days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 Dự Báo 3 Ngày Tới"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>

        <!-- Subtitle City -->
        <TextView
            android:id="@+id/tvCityName3Days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khu vực: Hà Nội"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Container chứa 3 Card ngày -->
        <LinearLayout
            android:id="@+id/container3Days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Ngày 1 -->
            <LinearLayout
                android:id="@+id/cardDay1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvDateDay1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hôm Nay (18/10)"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvTempDay1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28° / 22°C"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConditionDay1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛅ Có mây rải rác, không mưa"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#20FFFFFF"
                    android:layout_marginVertical="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/tvRainDay1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💧 Mưa: 10%"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvHumidityDay1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💨 Gió: 14 km/h"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvUVDay1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="☀️ UV: 5 (TB)"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAdviceDay1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Lời khuyên: Thời tiết lý tưởng cho các hoạt động ngoài trời."
                    android:textColor="#A0E0FF"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Card Ngày 2 -->
            <LinearLayout
                android:id="@+id/cardDay2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvDateDay2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ngày Mai (19/10)"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvTempDay2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="29° / 23°C"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConditionDay2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌧️ Mưa rào rải rác vào buổi chiều"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#20FFFFFF"
                    android:layout_marginVertical="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/tvRainDay2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💧 Mưa: 65%"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvHumidityDay2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💨 Gió: 18 km/h"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvUVDay2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="☀️ UV: 4 (TB)"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAdviceDay2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Lời khuyên: Hãy nhớ mang theo áo mưa hoặc ô khi ra ngoài vào buổi chiều."
                    android:textColor="#A0E0FF"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Card Ngày 3 -->
            <LinearLayout
                android:id="@+id/cardDay3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvDateDay3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ngày Kia (20/10)"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvTempDay3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30° / 24°C"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConditionDay3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️ Trời nắng đẹp, nhiều mây"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#20FFFFFF"
                    android:layout_marginVertical="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/tvRainDay3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💧 Mưa: 20%"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvHumidityDay3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💨 Gió: 12 km/h"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvUVDay3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="☀️ UV: 6 (Cao)"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAdviceDay3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Lời khuyên: Tia UV khá cao vào giữa trưa, nên thoa kem chống nắng."
                    android:textColor="#A0E0FF"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
