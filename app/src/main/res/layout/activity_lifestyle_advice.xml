<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackLifestyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/button_circle"
                android:contentDescription="Quay lại"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvLifestyleHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👕 Gợi Ý Đời Sống"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>

        <!-- City Subtitle -->
        <TextView
            android:id="@+id/tvLifestyleCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gợi ý thông minh cho khu vực: Hà Nội"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- 1. Trang phục -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTitleClothing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👕 Trang Phục Nên Mặc"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAdviceClothing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trang phục vải cotton mỏng nhẹ, thoáng mát, thấm hút mồ hôi tốt."
                android:textColor="#E0F7FA"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- 2. Mang ô / áo mưa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTitleUmbrella"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☂️ Mang Theo Ô / Áo Mưa"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAdviceUmbrella"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Khả năng mưa thấp, bạn có thể yên tâm ra đường mà không lo ướt."
                android:textColor="#E0F7FA"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- 3. Chống nắng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTitleSunscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧴 Bảo Vệ Da &amp; Chống Nắng"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAdviceSunscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chỉ số UV ở mức trung bình, nên thoa kem chống nắng SPF 30+ khi ra nắng trên 30 phút."
                android:textColor="#E0F7FA"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- 4. Thể thao -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTitleSport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏃 Thể Dục Thể Thao Ngoài Trời"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAdviceSport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thời tiết rất phù hợp để chạy bộ, đạp xe vào sáng sớm (5h30 - 7h00) hoặc chiều muộn (17h30)."
                android:textColor="#E0F7FA"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- 5. Phơi đồ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTitleLaundry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧺 Giặt &amp; Phơi Quần Áo"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAdviceLaundry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Độ ẩm vừa phải và có nắng nhẹ, quần áo sẽ khô nhanh trong khoảng 4-5 tiếng."
                android:textColor="#E0F7FA"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- 6. Rửa xe -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvTitleCarWash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚗 Rửa Xe Máy &amp; Ô Tô"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAdviceCarWash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thời tiết khô ráo trong 2-3 ngày tới, hôm nay là thời điểm rất tốt để rửa xe!"
                android:textColor="#E0F7FA"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
