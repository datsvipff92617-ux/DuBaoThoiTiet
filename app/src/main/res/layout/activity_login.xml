<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    android:fitsSystemWindows="true"
    android:padding="20dp"
    android:gravity="center">

    <!-- Logo hoặc Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☀️ Dự Báo Thời Tiết"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- Card chứa form đăng nhập -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng Nhập"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Username -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên đăng nhập"
            android:textColorHint="#64748B"
            android:textColor="#0F172A"
            android:background="@drawable/search_background"
            android:padding="14dp"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mật khẩu"
            android:textColorHint="#64748B"
            android:textColor="#0F172A"
            android:background="@drawable/search_background"
            android:padding="14dp"
            android:inputType="textPassword"
            android:layout_marginBottom="14dp"/>

        <!-- Nút Đăng nhập chính -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đăng Nhập"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_selected"
            android:padding="14dp"
            android:layout_marginBottom="12dp"/>

        <!-- Nút Tạo tài khoản mới -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Tạo Tài Khoản Mới (Đăng Ký)"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/button_normal"
            android:padding="12dp"
            android:layout_marginBottom="10dp"/>

        <!-- Gợi ý tài khoản mẫu nhỏ gọn -->
        <TextView
            android:id="@+id/tvDemoHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Bạn có thể đăng ký tài khoản tự do (Admin hoặc User), hoặc dùng tài khoản có sẵn: admin / 123456"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"/>


        <!-- Bỏ qua vào thẳng với tư cách Khách -->
        <TextView
            android:id="@+id/tvSkipLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚀 Bỏ qua đăng nhập (Vào xem ngay với tư cách Khách) →"
            android:textColor="#E0F7FA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</LinearLayout>