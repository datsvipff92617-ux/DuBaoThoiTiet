<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fitsSystemWindows="true">

    <!-- Main Content Layout -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header: User Badge & Quick Actions (GPS, Settings, Logout) -->
        <LinearLayout
            android:id="@+id/topHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👑 admin (Admin)"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/card_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/btnQuickGps"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@android:drawable/ic_menu_mylocation"
                android:padding="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/card_background"
                android:contentDescription="Định vị GPS chính xác"
                app:tint="@android:color/white" />

            <ImageView
                android:id="@+id/settingsButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_settings"
                android:padding="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/card_background"
                android:contentDescription="@string/menu_settings"
                app:tint="@android:color/white" />

            <ImageView
                android:id="@+id/btnLogout"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_logout"
                android:padding="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/card_background"
                android:contentDescription="Đăng xuất"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- Search Bar Row: Rộng rãi, độc lập, chữ tương phản cao, không bao giờ bị trắng mờ -->
        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/ivSearchIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/searchIconTint"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Tìm kiếm: Triều Khúc, Phùng Khoang, Hà Nội..."
                android:textColorHint="@color/searchBoxHint"
                android:textColor="@color/searchBoxText"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textSize="14sp"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:padding="6dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/searchBoxHint" />

            <ImageView
                android:id="@+id/searchButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@android:drawable/ic_menu_send"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/searchIconTint" />
        </LinearLayout>

        <!-- Weather Scrollable Body -->
        <ScrollView
            android:id="@+id/main3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/main2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="24dp">

                <!-- Hero Weather Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_background"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/cityNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hà Nội, Việt Nam"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/dateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thứ Ba, 27 tháng 10 2026"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/tempText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="29°C"
                        android:textColor="@android:color/white"
                        android:textSize="54sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/conditionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Có Mây"
                        android:textColor="#F0FFFFFF"
                        android:textSize="16sp"
                        android:layout_marginTop="2dp"/>

                    <!-- Quick Metrics Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:layout_marginTop="14dp"
                        android:background="#20FFFFFF"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvLabelFeelsLike"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cảm giác"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/feelsLikeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30°C"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvLabelHumidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Độ ẩm"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/humidityText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="55%"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvLabelWind"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tốc độ gió"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/windText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="13 km/h"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvLabelUv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chỉ số UV"
                                android:textColor="#B3FFFFFF"
                                android:textSize="11sp"/>
                            <TextView
                                android:id="@+id/uvText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 1: DỰ BÁO THỜI TIẾT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/feature_card_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvSection1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌦️ DỰ BÁO &amp; XU HƯỚNG THỜI TIẾT"
                        android:textColor="#E0F7FA"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="6dp">

                        <Button
                            android:id="@+id/btnForecast"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📅 Dự Báo 7 Ngày"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginEnd="4dp"
                            android:padding="8dp"/>

                        <Button
                            android:id="@+id/btnHourly"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🕐 Theo 24 Giờ"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginStart="4dp"
                            android:padding="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <Button
                            android:id="@+id/btnForecast3Days"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📅 3 Ngày Tới"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginEnd="3dp"
                            android:padding="8dp"/>

                        <Button
                            android:id="@+id/btnCompareWeather"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚖️ So Sánh 2 Nơi"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:padding="8dp"/>

                        <Button
                            android:id="@+id/btnSunMoon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌅 Thiên Văn"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginStart="3dp"
                            android:padding="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 2: SỨC KHỎE & AN TOÀN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/feature_card_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvSection2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌿 SỨC KHỎE, ĐỜI SỐNG &amp; AN TOÀN"
                        android:textColor="#C8E6C9"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="6dp">

                        <Button
                            android:id="@+id/btnAirQuality"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🍃 Không Khí AQI"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginEnd="4dp"
                            android:padding="8dp"/>

                        <Button
                            android:id="@+id/btnWeatherAlerts"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚠️ Cảnh Báo Thiên Tai"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginStart="4dp"
                            android:padding="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/btnLifestyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👕 Lời Khuyên Sinh Hoạt"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginEnd="4dp"
                            android:padding="8dp"/>

                        <Button
                            android:id="@+id/btnDisasterGuide"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🚨 Cẩm Nang Sinh Tồn"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginStart="4dp"
                            android:padding="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 3: VỊ TRÍ & TIỆN ÍCH -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/feature_card_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvSection3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧭 VỊ TRÍ, TIỆN ÍCH &amp; CÁ NHÂN"
                        android:textColor="#FFF9C4"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="6dp">

                        <Button
                            android:id="@+id/btnCurrentLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📍 Vị Trí Tôi Đang Sống"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginEnd="4dp"
                            android:padding="8dp"/>

                        <Button
                            android:id="@+id/btnSearchLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔍 Tìm Kiếm Địa Phương"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginStart="4dp"
                            android:padding="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/btnDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ℹ️ Thông Số Khí Quyển"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginEnd="4dp"
                            android:padding="8dp"/>

                        <Button
                            android:id="@+id/btnProfile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👤 Hồ Sơ Của Tôi"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:background="@drawable/button_normal"
                            android:layout_marginStart="4dp"
                            android:padding="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 4: QUẢN TRỊ ADMIN (CHỈ DÀNH RIÊNG CHO ADMIN - HOÀN TOÀN ẨN VỚI USER THƯỜNG) -->
                <LinearLayout
                    android:id="@+id/cardAdminSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/admin_card_background"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSection4Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👑 BẢNG ĐIỀU KHIỂN QUẢN TRỊ VIÊN (ADMIN ONLY)"
                        android:textColor="#FFE082"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvSection4Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khu vực kiểm soát tài khoản người dùng và cơ sở dữ liệu SQLite."
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp"/>

                    <Button
                        android:id="@+id/btnUserManagement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🛡️ Mở Bảng Quản Lý Người Dùng SQLite"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_selected"
                        android:padding="10dp"/>
                </LinearLayout>

                <!-- Link xem web bên ngoài -->
                <Button
                    android:id="@+id/btnFullForecast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌐 Xem Chi Tiết Trên Trang Web WeatherAPI"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/button_normal"
                    android:padding="10dp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Search Suggestions Overlay ListView -->
    <ListView
        android:id="@+id/searchSuggestionsListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/suggestions_background"
        android:divider="@color/suggestionDivider"
        android:dividerHeight="1dp"
        android:elevation="12dp"
        android:visibility="gone"/>

</FrameLayout>