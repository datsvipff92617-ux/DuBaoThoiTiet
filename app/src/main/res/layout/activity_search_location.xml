<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackSearchLoc"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/button_circle"
                android:contentDescription="Quay lại"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔍 Tìm Kiếm Khu Vực"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>

        <!-- Search Input Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/search_background"
            android:padding="6dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nhập tên tỉnh/thành phố mong muốn..."
                android:textColorHint="#80FFFFFF"
                android:textColor="@android:color/white"
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:textSize="15sp"
                android:inputType="text"
                android:imeOptions="actionSearch"/>

            <Button
                android:id="@+id/btnDoSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tìm"
                android:textColor="@android:color/white"
                android:background="@drawable/button_normal"
                android:paddingHorizontal="16dp"/>
        </LinearLayout>

        <!-- Autocomplete Suggestions List for 63 Provinces -->
        <LinearLayout
            android:id="@+id/layoutSearchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/suggestions_background"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSuggestionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 GỢI Ý ĐỊA PHƯƠNG PHÙ HỢP:"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:id="@+id/containerSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- Quick Result Card (Ban đầu ẩn, tìm ra thì hiện) -->
        <LinearLayout
            android:id="@+id/cardSearchResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvResultCityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đà Nẵng, Việt Nam"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvResultTemp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="29°C"
                    android:textColor="@android:color/white"
                    android:textSize="36sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvResultCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌤️ Nắng đẹp"
                    android:textColor="#E6FFFFFF"
                    android:textSize="16sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvResultDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Độ ẩm: 65% | Gió: 12 km/h | UV: 6"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="6dp"/>

            <Button
                android:id="@+id/btnSetAsMainCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xem Đầy Đủ Trên Trang Chủ"
                android:textColor="@android:color/white"
                android:background="@drawable/button_normal"
                android:padding="10dp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- Popular Cities in Vietnam Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏙️ Tỉnh &amp; Thành Phố Phổ Biến"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/chipHanoi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hà Nội"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/button_normal"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/chipHcm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TP. HCM"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/button_normal"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/chipDanang"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đà Nẵng"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/button_normal"/>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/chipHaiphong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hải Phòng"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/button_normal"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/chipCantho"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cần Thơ"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/button_normal"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/chipDalat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đà Lạt"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/button_normal"/>
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipNhatrang"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nha Trang"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/button_normal"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/chipHue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Huế"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/button_normal"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/chipSapa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sa Pa"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/button_normal"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Search History Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🕒 Lịch Sử Tìm Kiếm (SQLite)"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xóa tất cả"
                    android:textColor="#FF9999"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/tvEmptyHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có lịch sử tìm kiếm nào"
                android:textColor="#80FFFFFF"
                android:textSize="13sp"
                android:layout_gravity="center"
                android:padding="8dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
