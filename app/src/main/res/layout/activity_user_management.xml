<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnBackUserMgmt"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/button_circle"
            android:contentDescription="Quay lại"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👥 Quản Lý Người Dùng"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>

    <!-- Stats & Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvUserCountStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 Tổng số tài khoản trong hệ thống: 2"
            android:textColor="#E0F7FA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etSearchUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tìm theo tên đăng nhập hoặc họ tên..."
            android:textColorHint="#80FFFFFF"
            android:textColor="@android:color/white"
            android:background="@drawable/search_background"
            android:padding="10dp"
            android:textSize="14sp"
            android:inputType="text"/>
    </LinearLayout>

    <!-- User ListView -->
    <ListView
        android:id="@+id/lvUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"/>

    <TextView
        android:id="@+id/tvEmptyUsers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Không tìm thấy người dùng nào"
        android:textColor="#80FFFFFF"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:visibility="gone"/>

</LinearLayout>
