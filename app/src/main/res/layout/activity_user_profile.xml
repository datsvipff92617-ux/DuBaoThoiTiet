<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/button_circle"
                android:contentDescription="Quay lại"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvProfileHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 Hồ Sơ Cá Nhân"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>

        <!-- Avatar & Header info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/button_circle"
                android:text="👤"
                android:textSize="40sp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvProfileUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="username"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvProfileRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vai trò: Người dùng"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvProfileCreatedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngày tham gia: 18/10/2026"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Card Thông tin cá nhân -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvProfileBasicInfoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông Tin Cơ Bản"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Họ tên -->
            <TextView
                android:id="@+id/tvLabelFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Họ và tên"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etProfileFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/searchBoxText"
                android:textColorHint="@color/searchBoxHint"
                android:background="@drawable/search_background"
                android:padding="10dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="8dp"/>

            <!-- Email -->
            <TextView
                android:id="@+id/tvLabelEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/searchBoxText"
                android:textColorHint="@color/searchBoxHint"
                android:background="@drawable/search_background"
                android:padding="10dp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="8dp"/>

            <!-- Phone -->
            <TextView
                android:id="@+id/tvLabelPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số điện thoại"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/searchBoxText"
                android:textColorHint="@color/searchBoxHint"
                android:background="@drawable/search_background"
                android:padding="10dp"
                android:inputType="phone"
                android:layout_marginBottom="8dp"/>

            <!-- Location -->
            <TextView
                android:id="@+id/tvLabelLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khu vực sinh sống"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etProfileLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/searchBoxText"
                android:textColorHint="@color/searchBoxHint"
                android:background="@drawable/search_background"
                android:padding="10dp"
                android:inputType="text"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💾 Lưu Thông Tin Cá Nhân"
                android:textColor="@android:color/white"
                android:background="@drawable/button_normal"
                android:padding="12dp"/>
        </LinearLayout>

        <!-- Card Đổi mật khẩu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvProfileChangePassTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔐 Đổi Mật Khẩu"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etOldPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mật khẩu hiện tại"
                android:textColorHint="@color/searchBoxHint"
                android:textColor="@color/searchBoxText"
                android:background="@drawable/search_background"
                android:padding="10dp"
                android:inputType="textPassword"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mật khẩu mới (tối thiểu 6 ký tự)"
                android:textColorHint="@color/searchBoxHint"
                android:textColor="@color/searchBoxText"
                android:background="@drawable/search_background"
                android:padding="10dp"
                android:inputType="textPassword"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etConfirmNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Xác nhận mật khẩu mới"
                android:textColorHint="@color/searchBoxHint"
                android:textColor="@color/searchBoxText"
                android:background="@drawable/search_background"
                android:padding="10dp"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔑 Cập Nhật Mật Khẩu"
                android:textColor="@android:color/white"
                android:background="@drawable/button_normal"
                android:padding="12dp"/>
        </LinearLayout>

        <!-- Nút Đăng Xuất -->
        <Button
            android:id="@+id/btnLogoutProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚪 Đăng Xuất Khỏi Tài Khoản"
            android:textColor="#FF4D4D"
            android:textStyle="bold"
            android:background="@drawable/button_selected"
            android:padding="14dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
