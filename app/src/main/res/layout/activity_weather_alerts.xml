<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackAlerts"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/button_circle"
                android:contentDescription="Quay lại"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvAlertsHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ Cảnh Báo Khí Tượng"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>

        <!-- City Subtitle -->
        <TextView
            android:id="@+id/tvAlertsCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang quét dữ liệu cảnh báo tại Hà Nội..."
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Overall Risk Level Card -->
        <LinearLayout
            android:id="@+id/cardRiskOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvAlertLevelIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:text="🛡️"
                android:textSize="32sp"
                android:gravity="center"
                android:background="@drawable/button_circle"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvAlertLevelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trạng Thái: AN TOÀN"
                    android:textColor="#81C784"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvAlertLevelDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hiện không có hiện tượng thời tiết cực đoan nào nguy hiểm."
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Alert Items Container -->
        <LinearLayout
            android:id="@+id/containerAlertItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Item 1: Mưa lớn & Dông bão -->
            <LinearLayout
                android:id="@+id/cardRainAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvRainAlertTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌧️ Mưa Lớn &amp; Dông Sét"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvRainAlertStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xác suất mưa thấp (15%), không có nguy cơ ngập úng."
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Item 2: Nắng nóng & Sốc nhiệt -->
            <LinearLayout
                android:id="@+id/cardHeatAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvHeatAlertTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Nắng Nóng &amp; Sốc Nhiệt"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvHeatAlertStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhiệt độ ở mức dễ chịu (28°C), không có nguy cơ sốc nhiệt."
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Item 3: Bức xạ UV -->
            <LinearLayout
                android:id="@+id/cardUvAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvUvAlertTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️ Bức Xạ Tia Cực Tím (UV)"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvUvAlertStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chỉ số UV ở mức trung bình (5.0), hạn chế tiếp xúc nắng lâu."
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Item 4: Gió giật & Bão -->
            <LinearLayout
                android:id="@+id/cardWindAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvWindAlertTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💨 Gió Giật &amp; Áp Thấp Nhiệt Đới"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvWindAlertStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gió nhẹ khoảng 12 km/h, các phương tiện di chuyển an toàn."
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Emergency Advice Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvSafetyAdviceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Hướng Dẫn Phòng Tránh An Toàn"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvSafetyAdviceBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Thường xuyên kiểm tra dự báo thời tiết trước khi ra khỏi nhà.\n• Khi có dông sét, tuyệt đối không trú mưa dưới gốc cây to, cột điện.\n• Chuẩn bị sạc dự phòng và đèn pin khi có tin bão áp thấp.\n• Gọi tổng đài cứu nạn 114 khi gặp tình huống khẩn cấp."
                android:textColor="#E0F7FA"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
