<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackCompare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/button_circle"
                android:contentDescription="Quay lại"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚖️ So Sánh Thời Tiết"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="40dp"/>
        </LinearLayout>

        <!-- Input Selection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn 2 Khu Vực Cần So Sánh"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCity1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Khu vực 1 (Hà Nội)"
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@android:color/white"
                    android:background="@drawable/search_background"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:text="Hanoi"
                    android:layout_marginEnd="6dp"/>

                <EditText
                    android:id="@+id/etCity2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Khu vực 2 (TP.HCM)"
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@android:color/white"
                    android:background="@drawable/search_background"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:text="Ho Chi Minh"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnStartCompare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bắt Đầu Đối Sánh"
                android:textColor="@android:color/white"
                android:background="@drawable/button_normal"
                android:padding="12dp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- Side-by-Side Comparison Table -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Names Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCompareCity1Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hà Nội"
                    android:textColor="#80D8FF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VS"
                    android:textColor="#FFD54F"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"/>

                <TextView
                    android:id="@+id/tvCompareCity2Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TP. HCM"
                    android:textColor="#FF8A80"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Temperature -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCompareCity1Temp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="26°C"
                    android:textColor="@android:color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhiệt độ"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="8dp"/>

                <TextView
                    android:id="@+id/tvCompareCity2Temp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="32°C"
                    android:textColor="@android:color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Condition -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCompareCity1Condition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nhiều mây"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thời tiết"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="8dp"/>

                <TextView
                    android:id="@+id/tvCompareCity2Condition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nắng gắt"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:gravity="center"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginVertical="10dp"/>

            <!-- Humidity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCompareCity1Humidity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="75%"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Độ ẩm"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="8dp"/>

                <TextView
                    android:id="@+id/tvCompareCity2Humidity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="55%"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Wind -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCompareCity1Wind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="14 km/h"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tốc độ gió"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="8dp"/>

                <TextView
                    android:id="@+id/tvCompareCity2Wind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="20 km/h"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- UV -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCompareCity1UV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4 (TB)"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chỉ số UV"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="8dp"/>

                <TextView
                    android:id="@+id/tvCompareCity2UV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="9 (Rất cao)"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Conclusion & Analysis Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Đánh Giá &amp; Khuyến Nghị Di Chuyển"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvCompareConclusion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hà Nội hiện tại mát mẻ hơn TP. Hồ Chí Minh khoảng 6°C. Chỉ số UV tại TP. Hồ Chí Minh ở mức rất cao, nếu di chuyển vào lúc này bạn nên chuẩn bị kỹ đồ chống nắng."
                android:textColor="#E0F7FA"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
